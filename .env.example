# IDÆVIA Build — environment variables
# Copy to .env for local development. On Vercel, add each of these under
# Project → Settings → Environment Variables (Production).

# ---- Core -------------------------------------------------------------------
APP_URL="https://idaevia.app"                 # public URL (OAuth redirects, referral links, Whop)
AUTH_SECRET=""                                # long random string: openssl rand -base64 48
CRON_SECRET=""                                # random string; Vercel Cron calls /api/cron/reset-credits with it
ADMIN_EMAIL="admin@idaevia.app"               # seeded by `npm run db:seed`
ADMIN_PASSWORD=""                             # change after first login

# ---- Database: Supabase Postgres (Project Settings → Database → Connect → ORMs → Prisma)
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY=""                   # public (browser-safe)
SUPABASE_ANON_KEY=""                          # public, legacy JWT
SUPABASE_SECRET_KEY=""                        # PRIVATE, server only

# ---- AI providers ------------------------------------------------------------
ANTHROPIC_API_KEY=""                          # console.anthropic.com (needs credit balance)
OPENAI_API_KEY=""                             # platform.openai.com
# Optional per-tier model overrides:
# AI_TIER_FAST=claude-haiku-4-5
# AI_TIER_STANDARD=claude-sonnet-5
# AI_TIER_ADVANCED=claude-sonnet-5
# AI_TIER_PREMIUM=claude-opus-5
# AI_TIER_FRONTIER=claude-fable-5-1
# Shared across server instances via database admission leases.
AI_MAX_CONCURRENT=16
AI_MAX_USER_CONCURRENT=2

# ---- Social sign-in ----------------------------------------------------------
# Google: console.cloud.google.com → Credentials → OAuth client (Web)
#   redirect URI: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# GitHub: github.com/settings/developers → OAuth App
#   callback URL: ${APP_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ---- Whop (payments only) ----------------------------------------------------
# Only these three are required. Plans, credit packs and marketplace orders are
# created through the Whop API on the fly; nothing has to be set up in the dashboard.
WHOP_API_KEY=""                               # Whop dashboard → Developer → API keys
WHOP_COMPANY_ID=""                            # biz_… (Whop dashboard → Settings)
WHOP_WEBHOOK_SECRET=""                        # ws_… ; webhook URL: ${APP_URL}/api/webhooks/whop
# Optional legacy fallback: static checkout links + plan-id map instead of the API.
WHOP_APP_ID=""
WHOP_PLAN_MAP=""
WHOP_CHECKOUT_STARTER=""
WHOP_CHECKOUT_PRO=""
WHOP_CHECKOUT_MAX=""
WHOP_CHECKOUT_AGENCY=""
MARKETPLACE_DEV_PAYMENTS="false"              # true only for local testing without Whop

# Isolated project builds and 15-minute preview servers (server-only).
E2B_API_KEY=

# Optional: can also be configured securely in Admin → Email.
EMAIL_ENABLED="false"
RESEND_API_KEY=""
EMAIL_FROM="IDÆVIA <info@idaevia.app>"
EMAIL_REPLY_TO="info@idaevia.app"
