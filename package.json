{
  "name": "ai-web-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3737",
    "postinstall": "prisma generate",
    "build": "next build && node scripts/check-client-secrets.mjs",
    "start": "next start -p 3737",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p .",
    "db:push": "prisma db push --skip-generate",
    "db:seed": "node --conditions=react-server --import tsx prisma/seed.ts",
    "setup": "prisma db push --skip-generate && node --conditions=react-server --import tsx prisma/seed.ts",
    "tauri": "tauri",
    "vercel-build": "prisma generate && node scripts/prepare-email-schema.mjs && prisma db push --skip-generate && next build && node scripts/check-client-secrets.mjs",
    "db:migrate": "prisma db push --skip-generate",
    "test:security": "tsx --test tests/payment-math.test.ts tests/desktop-security.test.ts",
    "test:financial-security": "node scripts/test-financial-security.mjs",
    "test:terminal": "tsx --test tests/runtime.test.ts",
    "test:terminal:live": "node --env-file=.env --import tsx scripts/test-shell-live.ts",
    "test:terminal:http": "node scripts/test-financial-security.mjs --shell"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.127.0",
    "@codesandbox/sandpack-react": "^2.20.0",
    "@monaco-editor/react": "^4.7.0",
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "^6.19.3",
    "@types/three": "^0.186.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "e2b": "^2.51.0",
    "jose": "^6.2.12",
    "jszip": "^3.10.2",
    "lucide-react": "^1.47.0",
    "nanoid": "^6.0.1",
    "next": "16.3.6",
    "openai": "^7.20.0",
    "pg": "8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tempo-sdk": "^0.0.45",
    "three": "^0.186.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tauri-apps/cli": "^2.11.5",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "overrides": {
    "dompurify": "^3.4.15",
    "@prisma/config": {
      "deepmerge-ts": "^8.0.2"
    }
  }
}
