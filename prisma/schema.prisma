// IDÆVIA Build — data model
// Database: Supabase Postgres (production and local dev). See .env.example.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Supabase Postgres. DATABASE_URL = transaction pooler (6543, pgbouncer),
  // DIRECT_URL = direct connection (5432) used by `prisma db push` / migrations.
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String?
  passwordHash   String?
  avatarUrl      String?
  whopUserId     String?  @unique // Whop customer id (payments only)
  googleId       String?  @unique
  githubId       String?  @unique
  role           String   @default("USER") // USER | SUPPORTER | ADMIN
  plan           String   @default("FREE") // FREE | STARTER | PRO | MAX | AGENCY
  credits        Int      @default(100)
  /// Part of `credits` that was bought as packs; never expires at the monthly renewal. Always <= credits.
  purchasedCredits Int    @default(0)
  /// Bumped on password change: sessions issued with an older version are rejected.
  sessionVersion Int      @default(0)
  creditsResetAt DateTime @default(now())
  /// Marketplace earnings (USD cents) not yet paid out, and total paid out.
  sellerBalanceCents Int  @default(0)
  sellerPaidOutCents Int  @default(0)
  /// Where marketplace earnings are sent: "crypto" | "paypal"; details is JSON ({network,address} or {email}).
  payoutMethod   String?
  payoutDetails  String?
  payoutRequests PayoutRequest[]
  integrations   Integration[]
  /// Referral programme: every user has a share code; signups attribute to a user or an affiliate.
  referralCode         String?  @unique
  referredById         String?
  referredBy           User?    @relation("referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals            User[]   @relation("referrals")
  affiliateId          String?
  affiliate            Affiliate? @relation(fields: [affiliateId], references: [id], onDelete: SetNull)
  referralPaidRewarded Boolean  @default(false) // referrer already received the "friend went paid" bonus
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  marketingEmails Boolean @default(false)
  marketingConsentAt DateTime?
  emailOptOutToken String? @unique @default(uuid())
  emailDeliveries EmailDelivery[]
  supportThread SupportThread?
  projects    Project[]
  ledger      CreditLedger[]
  memberships Membership[]
  agentRuns   AgentRun[]
  purchases   Purchase[] @relation("buyer")
  sales       Purchase[] @relation("seller")
  commissions AffiliateCommission[]
}

/// Partner links managed by admins: /r/<code>. Earns a % of every plan payment by referred users.
model Affiliate {
  id            String   @id @default(cuid())
  name          String
  code          String   @unique
  commissionPct Float    @default(20)
  active        Boolean  @default(true)
  notes         String?
  contact       String? // email / handle for payouts
  createdAt     DateTime @default(now())

  users       User[]
  commissions AffiliateCommission[]
}

model AffiliateCommission {
  id              String    @id @default(cuid())
  affiliateId     String
  affiliate       Affiliate @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountCents     Int // what the referred user paid
  commissionCents Int
  pct             Float
  reason          String // plan:PRO, payment:pay_xxx, dev_upgrade:MAX
  status          String    @default("PENDING") // PENDING | PAID
  createdAt       DateTime  @default(now())
  paidAt          DateTime?

  @@index([affiliateId, status])
}

model Project {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  slug          String    @unique
  description   String?
  kind          String    @default("website") // website | saas | dashboard | app
  html          String    @default("")
  status        String    @default("DRAFT") // DRAFT | PUBLISHED
  publishedHtml String?
  publishedAt   DateTime?
  templateId    String?
  teamId        String?
  team          Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  clientStatus  String    @default("NONE") // NONE | REVIEW | CHANGES_REQUESTED | APPROVED
  memory        String    @default("{}") // JSON: brand, design DNA, decisions
  health        String? // JSON: last audit scores
  /// Per-project environment variables for deploys (AES-GCM encrypted JSON).
  envEncrypted  String?
  /// Last GitHub push: "owner/repo@sha"
  gitRemote     String?
  deployments   Deployment[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  versions   Version[]
  messages   Message[]
  agentRuns  AgentRun[]
  files      ProjectFile[]
  shareLinks ShareLink[]
  comments   Comment[]

  @@index([userId, updatedAt])
}

model Version {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number    Int
  html      String
  message   String
  createdAt DateTime @default(now())

  @@unique([projectId, number])
}

model Message {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role        String // user | assistant | system
  content     String
  agentId     String?
  model       String?
  creditsUsed Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([projectId, createdAt])
}

model AgentRun {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  agentId     String
  status      String    @default("QUEUED") // QUEUED | RUNNING | DONE | FAILED
  task        String
  output      String?
  model       String?
  creditsUsed Int       @default(0)
  inputTokens Int       @default(0)
  outputTokens Int      @default(0)
  costUsd     Float     @default(0) // provider list-price cost, for margin tracking
  /// Credit hold for this run, so a run whose server process was stopped can still be refunded.
  ledgerId    String?
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?

  @@index([projectId, startedAt])
  @@index([userId, startedAt])
  @@index([status, startedAt])
}

model CreditLedger {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta     Int
  reason    String
  /// Human-readable explanation shown to the user ("Builder · full page · Sonnet 5 · 42 KB document").
  note      String?
  /// JSON breakdown: agent, taskClass, tier, model, docKb, images, status…
  meta      String?
  projectId String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Membership {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  whopMembershipId String   @unique
  whopPlanId       String
  plan             String // mapped IDÆVIA plan
  status           String // active | inactive
  raw              String? // last webhook payload (JSON)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Setting {
  key       String   @id
  value     String // JSON
  updatedAt DateTime @updatedAt
}

/// Every Whop checkout we create, so webhooks can be attributed by checkout_configuration_id
/// even when Whop omits metadata or the buyer's email.
model WhopCheckout {
  id        String   @id // ch_… checkout configuration id
  userId    String
  kind      String // plan | pack | market
  plan      String? // STARTER | PRO | MAX | AGENCY
  credits   Int? // credit pack size
  purchaseId String? // marketplace order
  createdAt DateTime @default(now())

  @@index([userId])
}

/// A seller asks for their marketplace balance to be paid out; an admin approves (after sending the money) or rejects.
model PayoutRequest {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountCents Int
  method      String // crypto | paypal
  details     String // JSON snapshot of the payout destination at request time
  status      String    @default("PENDING") // PENDING | PAID | REJECTED
  note        String? // admin note (tx hash, reason)
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?

  @@index([status, createdAt])
  @@index([userId])
}

/// A third-party connection owned by a user (GitHub, Vercel, Supabase, Higgsfield…). Secrets are AES-GCM encrypted.
model Integration {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider  String // github | vercel | supabase | higgsfield | netlify
  label     String? // e.g. GitHub login, Vercel username, Supabase project ref
  secret    String // encrypted JSON of tokens/keys
  meta      String   @default("{}") // public JSON (username, url…)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, provider])
}

/// A deployment or push performed from the project terminal.
model Deployment {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  provider  String // idaevia | vercel | github
  status    String   @default("PENDING") // PENDING | READY | ERROR
  url       String?
  log       String   @default("")
  createdAt DateTime @default(now())
  finishedAt DateTime?

  @@index([projectId, createdAt])
}

model WebhookEvent {
  id        String   @id // webhook-id header (idempotency)
  type      String
  payload   String
  createdAt DateTime @default(now())
}

// ---------- Phase 2: multi-file apps, teams, portal, marketplace, custom agents ----------

model ProjectFile {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  path      String // e.g. "/App.tsx"
  content   String
  updatedAt DateTime @updatedAt

  @@unique([projectId, path])
}

model Team {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  ownerId    String
  whiteLabel String   @default("{}") // JSON: { brandName, logoUrl, accent, hideIdaevia }
  createdAt  DateTime @default(now())

  members  TeamMember[]
  projects Project[]
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String? // null while invite is pending
  email     String
  role      String   @default("EDITOR") // OWNER | ADMIN | DEVELOPER | DESIGNER | EDITOR | VIEWER
  status    String   @default("ACTIVE") // ACTIVE | PENDING
  createdAt DateTime @default(now())

  @@unique([teamId, email])
}

model ShareLink {
  id         String    @id @default(cuid())
  token      String    @unique
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label      String?
  password   String?
  canComment Boolean   @default(true)
  canApprove Boolean   @default(true)
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?
}

model Comment {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorName String
  authorId   String?
  body       String
  kind       String   @default("COMMENT") // COMMENT | CHANGE_REQUEST | APPROVAL
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model MarketItem {
  id          String   @id @default(cuid())
  type        String // template | prompt | component | agent
  title       String
  description String
  category    String   @default("General")
  price       Int      @default(0) // USD cents; 0 = free
  authorId    String
  authorName  String
  payload     String // JSON: { html } | { files } | { prompt } | { agent: {...} }  — never sent to non-buyers
  previewHtml String? // sanitised, script-free render for the public preview (websites only)
  installs    Int      @default(0)
  sales       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())

  purchases Purchase[]
}

/// A marketplace order. Paid through Whop; the platform keeps MARKETPLACE_FEE_PCT.
model Purchase {
  id             String    @id @default(cuid())
  itemId         String
  item           MarketItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  buyerId        String
  buyer          User      @relation("buyer", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId       String
  seller         User      @relation("seller", fields: [sellerId], references: [id], onDelete: Cascade)
  priceCents     Int
  feeCents       Int // platform fee
  sellerCents    Int // credited to seller balance when paid
  status         String    @default("PENDING") // PENDING | PAID | REFUNDED
  whopCheckoutId String?
  whopPaymentId  String?   @unique
  createdAt      DateTime  @default(now())
  paidAt         DateTime?

  @@index([buyerId, itemId])
}

model CustomAgent {
  id           String   @id @default(cuid())
  userId       String
  teamId       String?
  name         String
  description  String   @default("")
  systemPrompt String
  tier         String   @default("standard") // fast | standard | advanced | premium
  multiplier   Float    @default(2)
  mode         String   @default("rewrite") // rewrite | report
  isPublic     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Persistent conversation with the IDÆVIA Agent (ideas, design directions, project proposals).
model AssistantMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String // user | assistant
  content   String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// Fixed-window rate limiting (works across serverless instances).
model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime
}

/// Durable, server-verified money ledger. IDs and amounts never come from a browser request.
/// Plain user IDs preserve accounting if an account is removed.
model Payment {
  id                       String   @id // Whop pay_ id; prevents duplicate settlement across webhook IDs
  userId                   String
  kind                     String // plan | pack | market
  plan                     String?
  membershipId             String?
  purchaseId               String?
  creditsGranted           Int      @default(0)
  referralBonusCredits     Int      @default(0)
  providerUpdatedAt        DateTime?
  grossCents               Int // creator subtotal, excluding tax and buyer fees
  feeCents                 Int? // null means not reported, never silently treated as confirmed zero
  refundedCents            Int      @default(0)
  disputedCents            Int      @default(0)
  sellerCents              Int      @default(0)
  referralCommissionCents  Int      @default(0)
  affiliateCommissionCents Int      @default(0)
  paidAt                   DateTime
  updatedAt                DateTime @updatedAt

  @@index([userId, paidAt])
  @@index([paidAt])
}

model ReferralCommission {
  id              String   @id @default(cuid())
  paymentId       String   @unique
  referrerId      String
  buyerId         String
  amountCents     Int
  commissionCents Int
  reversedCents   Int      @default(0)
  pct             Int      @default(5)
  createdAt       DateTime @default(now())

  @@index([referrerId, createdAt])
}

/// Costs not available from the payment/AI APIs, e.g. hosting, taxes, payout fees.
model FinancialExpense {
  id          String   @id @default(cuid())
  amountCents Int
  category    String
  note        String
  incurredAt  DateTime
  createdBy   String
  createdAt   DateTime @default(now())
}

model SupportThread {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       String   @default("BOT") // BOT | WAITING | HUMAN | CLOSED
  assignedTo   String?
  botTurns     Int      @default(0)
  botToken     String?
  botUntil     DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  messages     SupportMessage[]

  @@index([status, updatedAt])
}

model SupportMessage {
  id           String   @id @default(cuid())
  threadId     String
  thread       SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role         String   // user | assistant | manager | system
  content      String
  authorName   String?
  clientId     String
  createdAt    DateTime @default(now())

  @@unique([threadId, clientId])
  @@index([threadId, createdAt, id])
}


model EmailDelivery {
  id              String   @id @default(cuid())
  eventKey        String   @unique
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind            String
  subject         String
  body            String
  ctaLabel        String?
  ctaUrl          String?
  marketing       Boolean  @default(false)
  status          String   @default("PENDING") // PENDING | SENDING | SENT | FAILED | REVIEW | SUPPRESSED
  attempts        Int      @default(0)
  nextAttemptAt   DateTime @default(now())
  firstAttemptAt  DateTime?
  lockedUntil     DateTime?
  lockToken       String?
  wirePayload     String?
  uncertain       Boolean  @default(false)
  providerId      String?
  lastError       String?
  createdAt       DateTime @default(now())
  sentAt          DateTime?
  campaignId      String?
  campaign        EmailCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([userId, createdAt])
  @@index([campaignId, status])
}

model EmailCampaign {
  id         String   @id @default(cuid())
  subject    String
  body       String
  ctaLabel   String?
  ctaUrl     String?
  plan       String?
  createdBy  String
  status     String   @default("DRAFT") // DRAFT | QUEUED | CANCELLED
  createdAt  DateTime @default(now())
  queuedAt   DateTime?
  deliveries EmailDelivery[]
}

/// Operational failures only; never request bodies, credentials or customer source code.
model PlatformIncident {
  id            String   @id @default(cuid())
  fingerprint   String   @unique
  source        String
  code          String
  title         String
  area          String // PLATFORM | PROVIDER | PROJECT | UNKNOWN
  severity      String // CRITICAL | HIGH | MEDIUM
  status        String   @default("NEW") // NEW | INVESTIGATING | RESOLVED
  occurrences   Int      @default(1)
  revision      Int      @default(1)
  userId        String?
  projectId     String?
  runId         String?
  route         String?
  release       String?
  message       String
  stack         String?
  explanation   String
  steps         String // JSON string[]
  firstSeenAt   DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  updatedAt     DateTime @updatedAt
  resolvedAt    DateTime?
  updatedById   String?
  note          String   @default("")

  @@index([lastSeenAt])
  @@index([status, lastSeenAt])
  @@index([area, lastSeenAt])
  @@index([userId, lastSeenAt])
  @@index([projectId, lastSeenAt])
}
