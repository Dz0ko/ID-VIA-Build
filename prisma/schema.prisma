// IDÆVIA Build — data model
// Default: SQLite for local dev. Switch `provider` to "postgresql" and set
// DATABASE_URL to a Supabase/Postgres URL for production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String?
  passwordHash   String?
  avatarUrl      String?
  whopUserId     String?  @unique
  role           String   @default("USER") // USER | ADMIN
  plan           String   @default("FREE") // FREE | STARTER | PRO | MAX | AGENCY
  credits        Int      @default(100)
  creditsResetAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  projects    Project[]
  ledger      CreditLedger[]
  memberships Membership[]
  agentRuns   AgentRun[]
}

model Project {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  slug          String    @unique
  description   String?
  kind          String    @default("website") // website | saas | dashboard | app
  html          String    @default("")
  status        String    @default("DRAFT") // DRAFT | PUBLISHED
  publishedHtml String?
  publishedAt   DateTime?
  templateId    String?
  memory        String    @default("{}") // JSON: brand, design DNA, decisions
  health        String?   // JSON: last audit scores
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  versions  Version[]
  messages  Message[]
  agentRuns AgentRun[]
}

model Version {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number    Int
  html      String
  message   String
  createdAt DateTime @default(now())

  @@unique([projectId, number])
}

model Message {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role        String   // user | assistant | system
  content     String
  agentId     String?
  model       String?
  creditsUsed Int      @default(0)
  createdAt   DateTime @default(now())
}

model AgentRun {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agentId     String
  status      String    @default("QUEUED") // QUEUED | RUNNING | DONE | FAILED
  task        String
  output      String?
  model       String?
  creditsUsed Int       @default(0)
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
}

model CreditLedger {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta     Int
  reason    String
  projectId String?
  createdAt DateTime @default(now())
}

model Membership {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  whopMembershipId String   @unique
  whopPlanId       String
  plan             String   // mapped IDÆVIA plan
  status           String   // active | inactive
  raw              String?  // last webhook payload (JSON)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Setting {
  key       String   @id
  value     String   // JSON
  updatedAt DateTime @updatedAt
}

model WebhookEvent {
  id        String   @id // webhook-id header (idempotency)
  type      String
  payload   String
  createdAt DateTime @default(now())
}
