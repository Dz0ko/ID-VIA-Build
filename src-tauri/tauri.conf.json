{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "IDÆVIA Build",
  "version": "0.1.0",
  "identifier": "app.idaevia.build",
  "build": {
    "frontendDist": "https://idaevia.app",
    "devUrl": "http://localhost:3737",
    "beforeDevCommand": "npm run dev"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "IDÆVIA Build",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "theme": "Dark",
        "url": "/app",
        "userAgent": "Mozilla/5.0 AppleWebKit/605.1.15 (KHTML, like Gecko) IDAEVIA-Desktop/0.1.0",
        "devtools": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
